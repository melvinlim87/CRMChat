// CRMChat — chat-based CRM with WhatsApp Business integration
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())

  leads Lead[]
  notes Note[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  phone     String?    @unique
  email     String?
  company   String?
  status    LeadStatus @default(NEW)
  source    String?    @default("whatsapp")
  tags      String[]   @default([])
  ownerId   String?
  owner     User?      @relation(fields: [ownerId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  conversation Conversation?
  notes        Note[]
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Conversation {
  id            String   @id @default(cuid())
  leadId        String   @unique
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel       String   @default("whatsapp")
  lastMessageAt DateTime @default(now())
  unreadCount   Int      @default(0)
  createdAt     DateTime @default(now())

  messages Message[]
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  status         String           @default("sent")
  externalId     String? // WhatsApp message id
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

model Integration {
  id        String   @id @default(cuid())
  provider  String   @unique // e.g. "whatsapp", "google", "slack"
  status    String   @default("disconnected")
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AutomationTrigger {
  MESSAGE_RECEIVED
}

enum AutomationAction {
  AUTO_REPLY
  ADD_TAG
  SET_STATUS
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "ai"
  value     Json
  updatedAt DateTime @updatedAt
}

// Saved canned responses / quick replies for the chat composer.
model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

// A published/editable marketing page built in the drag-and-drop site builder.
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  published Boolean  @default(false)
  blocks    Json     @default("[]") // ordered array of widget blocks
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Flow {
  id        String   @id @default(cuid())
  name      String
  enabled   Boolean  @default(false)
  keyword   String? // optional trigger keyword; empty = any inbound message
  graph     Json     @default("{}") // { nodes: [...], edges: [...] }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs FlowRun[]
}

// Tracks where a conversation currently is inside a flow, so flows can span
// multiple messages (multi-turn). One active run per conversation.
model FlowRun {
  id             String   @id @default(cuid())
  flowId         String
  flow           Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  conversationId String   @unique
  currentNodeId  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Automation {
  id          String            @id @default(cuid())
  name        String
  enabled     Boolean           @default(true)
  trigger     AutomationTrigger @default(MESSAGE_RECEIVED)
  keyword     String? // substring match on inbound text; empty = any message
  action      AutomationAction
  actionValue String // reply text, tag name, or target status
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}
