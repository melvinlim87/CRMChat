# --- Database ---
# Local Postgres via docker-compose (see docker-compose.yml)
DATABASE_URL="postgresql://crmchat:crmchat@localhost:5432/crmchat?schema=public"

# --- Auth ---
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- WhatsApp Business Cloud API (Meta) ---
# From your Meta App > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Any string you choose; you enter the same value in the Meta webhook config
WHATSAPP_VERIFY_TOKEN="my-verify-token"
WHATSAPP_API_VERSION="v21.0"

# --- Google (Gmail, Calendar, Drive) ---
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: override the OAuth redirect URI (defaults to <origin>/api/integrations/google/callback)
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# --- "Sign in with Google" (uses the same GOOGLE_CLIENT_ID/SECRET above) ---
# Add this redirect URI in Google Cloud too: <origin>/api/auth/google/callback
# Lock down who can sign in (recommended before going live). If both are blank,
# anyone with a Google account can sign in.
# GOOGLE_ALLOWED_DOMAIN="youragency.com"
# GOOGLE_ALLOWED_EMAILS="you@gmail.com,teammate@gmail.com"
